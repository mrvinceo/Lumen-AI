rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'ZqpJke7dXaXj4aKsBdLycqIiXgK2' ||
        ('email' in request.auth.token && request.auth.token.email == 'paulvincent@oca.ac.uk') ||
        ('email' in request.auth.token && request.auth.token.email.matches('(?i)^paulvincent@oca\\.ac\\.uk$'))
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Collections ---

    match /chat_history/{msgId} {
      // Allow user to see their own messages
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow user to write their own messages
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Admins can see all history
      allow read: if isAdmin();
    }

    match /chat_sessions/{sessionId} {
      // Allow user to see and write their own sessions
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /feedbackThemes/{themeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /folders/{folderId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /chunks/{chunkId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /moodleUnits/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if isAdmin();
      allow write: if false; // Only server (Firebase Admin) should write stats
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /personas/{personaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /study_schedules/{scheduleId} {
      // Allow user to read and delete their own schedules
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow user to create schedules signed as themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

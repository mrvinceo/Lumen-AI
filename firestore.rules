rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'ZqpJke7dXaXj4aKsBdLycqIiXgK2' ||
        ('email' in request.auth.token && request.auth.token.email == 'paulvincent@oca.ac.uk') ||
        ('email' in request.auth.token && request.auth.token.email.matches('(?i)^paulvincent@oca\\.ac\\.uk$')) ||
        request.auth.token.admin == true
      );
    }

    function isStaff() {
      return isSignedIn() && (request.auth.token.staff == true || isAdmin());
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Non-staff (student) content: audience missing or "all"
    function isPublicAudience() {
      return !('audience' in resource.data) || resource.data.audience == 'all';
    }

    function isStaffAudience() {
      return 'audience' in resource.data && resource.data.audience == 'staff';
    }

    function canReadAudienceDoc() {
      return isSignedIn() && (
        isAdmin() ||
        (isStaffAudience() && isStaff()) ||
        isPublicAudience()
      );
    }

    // --- Collections ---

    match /chat_history/{msgId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    match /chat_sessions/{sessionId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /feedbackThemes/{themeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /folders/{folderId} {
      allow read: if canReadAudienceDoc();
      allow write: if isAdmin();
    }

    match /chunks/{chunkId} {
      allow read: if canReadAudienceDoc();
      allow write: if isAdmin();
    }

    // Personal staff uploads — owner only
    match /user_chunks/{chunkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isStaff();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /moodleUnits/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if isAdmin();
      allow write: if false; // Only server (Firebase Admin) should write stats
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /personas/{personaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /study_schedules/{scheduleId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
